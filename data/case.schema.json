{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fde-case-library:case.schema.json",
  "title": "FDE Enterprise AI Case",
  "type": "object",
  "required": [
    "id", "source", "company", "industry", "industry_group", "scenario",
    "fde", "fde_relation", "problem", "solution", "human", "result", "maturity",
    "maturity_stage", "url", "architecture", "components", "fde_actions",
    "reusable", "evidence", "case_summary", "evidence_level", "evidence_label",
    "source_record", "analysis_boundary", "verification_notes", "additional_sources",
    "detail_score", "detail_level", "detail_label", "detail_dimensions", "missing_details"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "technical_reference": { "type": "boolean" },
    "source": { "type": "string" },
    "company": { "type": "string", "minLength": 1 },
    "industry": { "type": "string", "minLength": 1 },
    "industry_group": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "fde": { "type": "string", "minLength": 1 },
    "fde_relation": { "type": "string" },
    "problem": { "type": "string", "minLength": 10 },
    "solution": { "type": "string", "minLength": 20 },
    "human": { "type": "string", "minLength": 10 },
    "result": { "type": "string", "minLength": 10 },
    "maturity": { "type": "string", "minLength": 1 },
    "maturity_stage": { "enum": ["验证阶段", "已上线", "规模化", "未明确"] },
    "url": { "type": "string", "pattern": "^https://" },
    "architecture": { "$ref": "#/$defs/nonEmptyStrings" },
    "components": { "$ref": "#/$defs/nonEmptyStrings" },
    "fde_actions": { "$ref": "#/$defs/nonEmptyStrings" },
    "reusable": { "$ref": "#/$defs/nonEmptyStrings" },
    "evidence": { "type": "string", "minLength": 1 },
    "case_summary": { "type": "string", "minLength": 30 },
    "evidence_level": { "enum": ["A", "B", "C", "D"] },
    "evidence_label": { "type": "string" },
    "detail_score": { "type": "integer", "minimum": 0, "maximum": 12 },
    "detail_level": { "enum": ["deep", "standard", "overview"] },
    "detail_label": { "type": "string", "minLength": 1 },
    "detail_dimensions": {
      "type": "object",
      "required": ["business_context", "solution_workflow", "technical_workflow", "human_governance", "measured_outcome", "source_traceability"],
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }
    },
    "missing_details": { "type": "array", "items": { "type": "string" } },
    "source_record": {
      "type": "object",
      "required": ["title", "publisher", "url", "source_type", "directness", "claim_origin", "independently_verified", "accessed_at"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "source_type": { "type": "string", "minLength": 1 },
        "directness": { "type": "string", "minLength": 1 },
        "claim_origin": { "type": "string", "minLength": 1 },
        "independently_verified": { "type": "boolean" },
        "accessed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": true
    },
    "analysis_boundary": {
      "type": "object",
      "required": ["business_problem", "solution", "architecture", "fde_actions", "result"],
      "additionalProperties": { "type": "string" }
    },
    "verification_notes": { "$ref": "#/$defs/nonEmptyStrings" },
    "additional_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
